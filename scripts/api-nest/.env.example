# Exemple d'environnement pour l'API NestJS
# Remplir ces variables dans un fichier .env local avant de lancer l'API

# URL GeoSuivi pour récupérer la liste des rapports (GET)
# Exemple: https://geosuivi.example.com/api/getrapportlist
GEOSUIVI_GETRAPPORTLIST_URL=
# (Optionnel) alternative: base API URL
GEOSUIVI_API_URL=

# Port sur lequel l'API écoute
PORT=3001
NODE_ENV=development

# Configuration S3 (utilisée par les scripts de réparation/audit)
S3_BUCKET=du-medias
AWS_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Options opérationnelles (valeurs par défaut pour le comportement des scripts)
S3_PUT_RETRIES=5
S3_PUT_TIMEOUT_MS=900000
REPAIR_MEDIA_RETRIES=5
TARGET_BYTES=1048576
MIN_BYTES=0
ODK_MEDIA_COMPRESS_IMAGES=true
ODK_MEDIA_MAX_WIDTH=1600
ODK_MEDIA_JPEG_QUALITY=75
RAPPORT_DOWNLOAD_RETRIES=5

# Logs: emplacement (optionnel)
# LOG_DIR=./tmp

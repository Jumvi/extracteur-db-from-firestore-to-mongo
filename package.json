{
  "name": "firestore-to-mongodb-etl",
  "version": "1.0.0",
  "description": "ETL script pour migrer Firestore vers MongoDB",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "migrate": "node src/index.js",
    "odk:migrate": "node src/odk-migrate.js --once",
    "odk:migrate:daemon": "node src/odk-migrate.js --daemon --expand \"etat_troncon,propretes_obs,point_vue_usagers,group_avis_global,conclusion_points_positif,conclusion_points_ameliore,conclusion_recommandations\" ",
    "odk:migrate:daemon:expand": "node src/odk-migrate.js --daemon --all --expand \"etat_troncon,propretes_obs,point_vue_usagers,group_avis_global,conclusion_points_positif,conclusion_points_ameliore,conclusion_recommandations\"",
    "odk:migrate:batch50": "node src/odk-migrate.js --once --pageSize 50 --limit 50",
    "odk:migrate:batch50:reset": "node src/odk-migrate.js --once --pageSize 50 --limit 50 --reset-state",
    "odk:migrate:batch50:hydrated": "node src/odk-migrate.js --once --pageSize 50 --limit 50 --nav-depth 6",
    "odk:migrate:batch50:hydrated:reset": "node src/odk-migrate.js --once --pageSize 50 --limit 50 --reset-state --nav-depth 6",
    "odk:migrate:batch50:hydrated:skip-media": "node src/odk-migrate.js --once --pageSize 50 --limit 50 --nav-depth 6 --skip-media",
    "odk:migrate:batch50:expand": "node src/odk-migrate.js --once --all --pageSize 50 --limit 50 --nav-depth 6 --expand \"etat_troncon,propretes_obs,point_vue_usagers,group_avis_global,conclusion_points_positif,conclusion_points_ameliore,conclusion_recommandations\"",
    "odk:test:first50": "node scripts/fetchFirst50.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "firestore",
    "mongodb",
    "etl",
    "migration",
    "database"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.986.0",
    "axios": "^1.13.5",
    "commander": "^14.0.3",
    "dotenv": "^16.3.1",
    "firebase-admin": "^12.0.0",
    "mongodb": "^6.3.0",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "pino": "^10.3.1"
  }
}

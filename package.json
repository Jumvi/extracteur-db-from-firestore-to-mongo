{
  "name": "firestore-to-mongodb-etl",
  "version": "1.0.0",
  "description": "ETL script pour migrer Firestore vers MongoDB",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "migrate": "node src/index.js",
    "mongo:copy:selected": "node scripts/mongoCopySelectedCollections.js",
    "odk:listForms": "node scripts/listForms.js",
    "odk:migrate": "node src/odk-migrate.js --once --exclude-tests",
    "odk:migrate:daemon": "node src/odk-migrate.js --daemon --exclude-tests --expand \"etat_troncon,propretes_obs,point_vue_usagers,group_avis_global,conclusion_points_positif,conclusion_points_ameliore,conclusion_recommandations\" ",
    "odk:migrate:daemon:expand": "node src/odk-migrate.js --daemon --all --exclude-tests --expand \"etat_troncon,propretes_obs,point_vue_usagers,group_avis_global,conclusion_points_positif,conclusion_points_ameliore,conclusion_recommandations\"",
    "odk:migrate:batch50": "node src/odk-migrate.js --once --exclude-tests --pageSize 50 --limit 50",
    "odk:migrate:batch50:reset": "node src/odk-migrate.js --once --exclude-tests --pageSize 50 --limit 50 --reset-state",
    "odk:migrate:batch50:hydrated": "node src/odk-migrate.js --once --exclude-tests --pageSize 50 --limit 50 --nav-depth 6",
    "odk:migrate:batch50:hydrated:reset": "node src/odk-migrate.js --once --exclude-tests --pageSize 50 --limit 50 --reset-state --nav-depth 6",
    "odk:migrate:batch50:hydrated:skip-media": "node src/odk-migrate.js --once --exclude-tests --pageSize 50 --limit 50 --nav-depth 6 --skip-media",
    "odk:migrate:batch50:expand": "node src/odk-migrate.js --once --all --exclude-tests --pageSize 50 --limit 50 --nav-depth 6 --expand \"etat_troncon,propretes_obs,point_vue_usagers,group_avis_global,conclusion_points_positif,conclusion_points_ameliore,conclusion_recommandations\"",
    "odk:backfill:plan-windows:auto-range:print-only": "node tmp/run_backfill_windows.js --auto-range --window-days 3 --print-only",
    "odk:backfill-media:window:2026-02-06_02-08:c2m2": "node src/odk-migrate.js --form audit_chantier_routier_ouvrage_v1 --project 1 --since 2026-02-06 --until 2026-02-08 --ignore-state --backfill-media --backfill-doc-concurrency 2 --media-concurrency 2 --once",
    "odk:backfill-media:window:2026-02-07_02-11:c2m2": "node src/odk-migrate.js --form audit_chantier_routier_ouvrage_v1 --project 1 --since 2026-02-07 --until 2026-02-11 --ignore-state --backfill-media --backfill-doc-concurrency 2 --media-concurrency 2 --once",
    "odk:backfill-media:window:2026-02-07_02-11:c1m1": "node src/odk-migrate.js --form audit_chantier_routier_ouvrage_v1 --project 1 --since 2026-02-07 --until 2026-02-11 --ignore-state --backfill-media --backfill-doc-concurrency 1 --media-concurrency 1 --once",
    "odk:backfill-media:window:2026-02-10_02-14:c2m2": "node src/odk-migrate.js --form audit_chantier_routier_ouvrage_v1 --project 1 --since 2026-02-10 --until 2026-02-14 --ignore-state --backfill-media --backfill-doc-concurrency 2 --media-concurrency 2 --once",
    "mongo:media-window-status:2026-02-06_02-08": "node tmp/mongo_media_window_status.js audit_chantier_routier_ouvrage_v1 2026-02-06 2026-02-08",
    "mongo:media-window-status:2026-02-07_02-11": "node tmp/mongo_media_window_status.js audit_chantier_routier_ouvrage_v1 2026-02-07 2026-02-11",
    "mongo:media-window-status:2026-02-10_02-14": "node tmp/mongo_media_window_status.js audit_chantier_routier_ouvrage_v1 2026-02-10 2026-02-14",
    "geosuivi:spaces:copy-media:flagged:dry-run": "node tmp/geosuivi_spaces_copy_media.js --dry-run --limit-rapports 30",
    "geosuivi:spaces:copy-media:flagged": "node tmp/geosuivi_spaces_copy_media.js --limit-rapports 30",
    "geosuivi:spaces:repair-missing:dry-run": "node tmp/geosuivi_spaces_repair_missing_media.js --dry-run",
    "geosuivi:spaces:repair-missing": "node tmp/geosuivi_spaces_repair_missing_media.js",
    "odk:test:first50": "node scripts/fetchFirst50.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "firestore",
    "mongodb",
    "etl",
    "migration",
    "database"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.986.0",
    "axios": "^1.13.5",
    "commander": "^14.0.3",
    "dotenv": "^16.3.1",
    "firebase-admin": "^12.0.0",
    "mongodb": "^6.3.0",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "pino": "^10.3.1",
    "sharp": "^0.34.3"
  }
}

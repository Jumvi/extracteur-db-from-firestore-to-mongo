# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-key.json

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DATABASE=your_database_name

# Options de migration
BATCH_SIZE=500
LOG_LEVEL=info

# ============================
# ODK Central -> Mongo (optionnel)
# ============================
# ODK Central base API URL (souvent /v1)
ODK_BASE_URL=https://your-odk-central.example.com/v1

# URL de login (sessions). Si vide, le script assume une auth déjà gérée côté reverse-proxy.
ODK_LOGIN_URL=https://your-odk-central.example.com/v1/sessions

# Identifiants ODK Central (ne pas commiter)
ODK_EMAIL=
ODK_PASS=

# Project ODK (par défaut 1)
ODK_PROJECT=1

# Template URL OData pour les Submissions.
# Si vous gardez cette valeur, le script sait aussi résoudre les @odata.navigationLink.
ODK_SUBMISSIONS_URL_TEMPLATE=https://your-odk-central.example.com/v1/projects/{projectId}/forms/{formId}.svc/Submissions?{query}

# Optionnel : template URL pour télécharger les pièces jointes.
# Si non fourni, un endpoint par défaut ODK Central est utilisé.
MEDIA_URL_TEMPLATE=https://your-odk-central.example.com/v1/projects/{projectId}/forms/{formId}/submissions/{instanceId}/attachments/{filename}

# Optionnel : URL proxy pour le frontend (sert juste à construire attachments[].proxyUrl)
ODK_ATTACHMENT_PROXY_TEMPLATE=/api/getAttachment?formId={formId}&instanceId={instanceId}&filename={filename}

# Exclure les submissions marquées test/tests (par défaut: false)
ODK_EXCLUDE_TESTS=true

# ============================
# Stockage média (optionnel)
# ============================
# Si S3 n'est pas configuré, les médias sont stockés dans Mongo GridFS (bucket: odk_media).

# Compression d'images avant upload S3 (optionnel)
# - Désactivé par défaut pour préserver le comportement actuel.
# - S'applique seulement aux .jpg/.jpeg/.png.
ODK_MEDIA_COMPRESS_IMAGES=false
ODK_MEDIA_MAX_WIDTH=1920
ODK_MEDIA_JPEG_QUALITY=80
ODK_MEDIA_PNG_COMPRESSION_LEVEL=9

# DigitalOcean Spaces / S3 compatible
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ACL appliquée lors de l'upload (défaut dans le code: public-read)
S3_PUBLIC_ACL=public-read

# Pour URLs publiques via CDN (optionnel)
S3_USE_CDN=false
S3_CDN=

# Modèle d'URL publique. Tokens supportés: {cdn}, {bucket}, {key}
S3_PUBLIC_URL_TEMPLATE={cdn}/{key}

